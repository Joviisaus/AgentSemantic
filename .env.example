# --------------------------------------------------------------------
# AgentSematic 环境变量样板
# --------------------------------------------------------------------
# 把本文件复制为 `.env`（同目录），再填入真实 API Key 即可。
# `.env` 已在 .gitignore 中忽略，不会被误提交到 Git。
#
# 也可以直接 export / $env: 设置环境变量，效果等价。
# --------------------------------------------------------------------

# OpenAI（gpt-4o / gpt-4o-mini ...）
OPENAI_API_KEY=

# Anthropic（Claude 3.5 sonnet / opus ...）
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# 阿里 DashScope（Qwen-VL）
DASHSCOPE_API_KEY=

# 智谱 BigModel（GLM-4V）
ZHIPU_API_KEY=

# Moonshot Kimi
MOONSHOT_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 字节跳动火山方舟 ARK（同一把 key 覆盖控制台里所有已开通的模型 / 接口）：
#   - Doubao 多模态：doubao-seed-2-0-pro-260215 / doubao-1-5-vision-pro-32k ...
#   - DeepSeek + Web Search：deepseek-v4-pro-260425 走 /api/v3/responses
#   - 视频生成（Seedance 2.0 等）：/api/v3/contents/generations/tasks
# 控制台: https://console.volcengine.com/ark
BYTEDANCE_ARK_API_KEY=
# 向后兼容别名（vlm_config.yaml 仍读 ${ARK_API_KEY}），与上面同值。
ARK_API_KEY=

# 自定义 OpenAI 兼容服务
CUSTOM_VLM_API_KEY=
CUSTOM_VLM_BASE_URL=
