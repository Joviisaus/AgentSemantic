# --------------------------------------------------------------------
# AgentSematic 环境变量样板
# --------------------------------------------------------------------
# 把本文件复制为 `.env`（同目录），再填入真实 API Key 即可。
# `.env` 已在 .gitignore 中忽略，不会被误提交到 Git。
#
# 也可以直接 export / $env: 设置环境变量，效果等价。
# --------------------------------------------------------------------

# OpenAI（gpt-4o / gpt-4o-mini ...）
OPENAI_API_KEY=

# Anthropic（Claude 3.5 sonnet / opus ...）
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# 阿里 DashScope（Qwen-VL）
DASHSCOPE_API_KEY=

# 智谱 BigModel（GLM-4V）
ZHIPU_API_KEY=

# Moonshot Kimi
MOONSHOT_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 自定义 OpenAI 兼容服务
CUSTOM_VLM_API_KEY=
CUSTOM_VLM_BASE_URL=
